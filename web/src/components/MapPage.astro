---
/** The map page of one city: its region's flat map, opened centred on the city. */
import { CITIES, REGIONS } from "../../../pipeline/src/places.ts";
import { existsSync, readFileSync } from "node:fs";
import { HOSTING } from "../../../pipeline/src/hosting.ts";
declare const __WEB_CACHE__: string; // data/web/, injected by astro.config.mjs
interface Props { city: string; home?: boolean }
interface Preview { file: string; lqip: string }
interface World { files?: Record<string, string>; previews?: Record<string, { land: Preview; port: Preview }> }
const { city, home = false } = Astro.props;
const c = CITIES[city], region = REGIONS[c.region];
// map data comes from R2 (same-origin /regions in dev): start its downloads with the HTML, not after the script
const tilesOrigin = import.meta.env.DEV ? "" : HOSTING.origin;
const regionBase = `${tilesOrigin}/regions/${c.region}`, data = `${regionBase}/data`;
// the region's world.json as published (in dev: the export cache first, as the dev server serves it):
// names of the current content-hashed files to preload, and the city's preview
async function loadWorld(): Promise<World> {
  const local = `${__WEB_CACHE__}regions/${c.region}/data/world.json`;
  if (import.meta.env.DEV && existsSync(local)) return JSON.parse(readFileSync(local, "utf8"));
  try {
    const r = await fetch(`${HOSTING.origin}/regions/${c.region}/data/world.json?build=${Date.now()}`);
    return r.ok ? await r.json() : {};
  } catch { return {}; }
}
const world = await loadWorld();
const preload = world.files ? [world.files["tiles-map"], world.files.borders].filter(Boolean) : ["tiles.json", "borders.json"];
const pv = world.previews?.[city];
const title = home ? "Mondo Isometrico" : `${c.title} · Mondo Isometrico`;
const description = home ? "Una mappa isometrica di Roma da open data." : `${c.title}: una mappa isometrica da open data.`;
// crawlers need absolute URLs: site comes from SITE_DOMAIN (astro.config.mjs)
const site = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), site).href, ogImage = new URL(`/og/${home ? "index" : city}.jpg`, site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#e8e4dc" />
		<meta name="color-scheme" content="dark" />
		<title>{title}</title>
		{tilesOrigin && <link rel="preconnect" href={tilesOrigin} crossorigin="anonymous" />}
		<link rel="preload" href={`${data}/world.json`} as="fetch" crossorigin="anonymous" />
		{preload.map((f) => <link rel="preload" href={`${data}/${f}`} as="fetch" crossorigin="anonymous" />)}
		<meta name="description" content={description} />
		{/* social cards: web/public/og/<city>.jpg, made by pipeline/src/og.ts from the published tiles */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Mondo Isometrico" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={home ? "Mondo Isometrico, una mappa isometrica di Roma da open data" : `${c.title}, mappa isometrica`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		{/* Pirsch Analytics (cookie-free), proxied first-party by worker/index.ts; the access key is a Worker secret */}
		{!import.meta.env.DEV && <script is:inline defer src="/p/s.js" id="pianjs" data-hit-endpoint="/p/v" data-event-endpoint="/p/e" data-session-endpoint="/p/k"></script>}
	</head>
	<body data-city={city} data-region={c.region}>
		<div id="map"></div>
		{pv && (
			/* the opening view as one image (and a blurred inline version until it loads); map.ts fades it out
			   once the tiles are in. Laid out like the viewer opens the city: full width, centred vertically. */
			<div id="preview" aria-hidden="true" style={`--lqip-land: url(${pv.land.lqip}); --lqip-port: url(${pv.port.lqip})`}>
				<div class="frame">
					<div class="lqip"></div>
					<picture>
						<source media="(max-aspect-ratio: 5/4)" srcset={`${regionBase}/${pv.port.file}`} type="image/avif" />
						<img src={`${regionBase}/${pv.land.file}`} alt="" fetchpriority="high" decoding="async" />
					</picture>
				</div>
			</div>
		)}
		<script is:inline>
			// a deep link (#@x,y,z, #metro, ?at=) opens somewhere else: no preview
			if (/^#(@|metro)/.test(location.hash) || new URLSearchParams(location.search).has("at")) document.getElementById("preview")?.remove();
		</script>
		<!-- light of the hour and weather over the tiles (ambient.ts): multiply tint + soft wash, never repainting -->
		<div id="ambient-tint" aria-hidden="true"></div>
		<div id="ambient-wash" aria-hidden="true"></div>
		<!-- street lamps, headlights, floodlit monuments over the night tint (lights.ts) -->
		<canvas id="lights" aria-hidden="true"></canvas>
		<div id="ambient" class="ui" role="group" aria-label="Ora e meteo">
			<div class="row">
				<span class="now">Roma <b id="ambient-clock">--:--</b> · <span id="ambient-weather">meteo…</span></span>
				<span class="actions">
					<button type="button" id="share" title="Condividi questa vista" aria-label="Condividi questa vista">Condividi</button>
					<button type="button" id="help-toggle" aria-expanded="false" aria-controls="help" title="Aiuto">?</button>
				</span>
			</div>
			<div id="daytime" role="radiogroup" aria-label="Luce">
				<button type="button" data-mode="live" role="radio" aria-checked="true" title="L'ora e la luce reali di Roma, adesso">Adesso</button>
				<button type="button" data-mode="giorno" role="radio" aria-checked="false">Giorno</button>
				<button type="button" data-mode="pomeriggio" role="radio" aria-checked="false">Pomeriggio</button>
				<button type="button" data-mode="notte" role="radio" aria-checked="false">Notte</button>
			</div>
			<div id="help" hidden>
				<p>Roma disegnata da open data e dipinta con AI. Le zone dipinte crescono a ogni aggiornamento; fuori, la città resta sfocata tra le nuvole.</p>
				<p>Auto, bus e tram sono un'animazione illustrativa, solo nelle zone dipinte. Luce e meteo seguono l'ora e il tempo reali di Roma; con Giorno, Pomeriggio e Notte scegli tu la luce. Di notte la città si accende: lampioni lungo le strade (circa 3,6 ogni 100 m, la densità della rete di Roma), fari delle auto e monumenti illuminati.</p>
				<p class="keys"><b>H</b> nascondi comandi · <b>T</b> traffico · <b>P</b> foto/dipinto · <b>B</b> confini · <b>V</b> modalità video</p>
				<button type="button" id="feedback-open" aria-haspopup="dialog" aria-controls="feedback">Segnala un problema o un'idea</button>
			</div>
		</div>
		<!-- feedback (feedback.ts → api/feedback.ts → GitHub issue; fallback: prefilled issues/new link) -->
		<dialog id="feedback" aria-labelledby="feedback-title">
			<form id="feedback-form" novalidate>
				<div class="fb-head">
					<h2 id="feedback-title">Segnala un problema o un'idea</h2>
					<button type="button" class="fb-close" data-close aria-label="Chiudi" title="Chiudi">×</button>
				</div>
				<fieldset class="fb-kind">
					<legend>Tipo</legend>
					<label><input type="radio" name="kind" value="bug" checked /> Problema</label>
					<label><input type="radio" name="kind" value="idea" /> Idea</label>
				</fieldset>
				<label class="fb-field">Cosa hai notato?
					<textarea name="text" rows="5" minlength="10" maxlength="4000" required placeholder="Descrivi il problema o l'idea (dove, cosa vedi, cosa ti aspettavi)"></textarea>
				</label>
				<label class="fb-field">Contatto <span class="fb-opt">(facoltativo)</span>
					<input type="text" name="contact" maxlength="200" autocomplete="off" placeholder="email o @utente GitHub" />
				</label>
				<div class="fb-hp" aria-hidden="true"><label>Sito web <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
				<p class="fb-note">La segnalazione diventa una issue pubblica su GitHub, con il link alla vista attuale della mappa, dimensioni dello schermo e browser. Anche il contatto, se lo lasci, sarà pubblico.</p>
				<div class="fb-actions">
					<button type="button" data-close>Annulla</button>
					<button type="submit" id="feedback-send" class="fb-send">Invia</button>
				</div>
				<p id="feedback-status" class="fb-status" role="status" aria-live="polite"></p>
			</form>
		</dialog>
		<div id="zoom" class="ui" role="group" aria-label="Zoom">
			<button type="button" id="zoom-in" aria-label="Avvicina" title="Avvicina">+</button>
			<button type="button" id="zoom-out" aria-label="Allontana" title="Allontana">−</button>
		</div>
		<footer id="credits"></footer>
		<!-- video mode (?video or V): big credit line above the area social apps cover with their UI -->
		<div id="video-credit">{region.credits.map((line, i) => <>{i > 0 && <br />}{line}</>)}</div>

		<style is:global>
			html, body { margin: 0; height: 100%; background: #e8e4dc; font-family: ui-sans-serif, system-ui, sans-serif; overflow: hidden;
				overscroll-behavior: none; -webkit-tap-highlight-color: transparent; -webkit-text-size-adjust: 100%; }
			/* the map owns every gesture: no browser pan/pinch/double-tap zoom of the page, no long-press callout */
			#map { touch-action: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
			#map { position: fixed; inset: 0; background: #e8e4dc; }
			/* zoom buttons: bottom right, above the credit line; "−" greys out at the zoom-out limit */
			#zoom { position: fixed; right: 16px; bottom: calc(var(--credits-h, 32px) + 12px); z-index: 3; display: flex; flex-direction: column;
				border-radius: 10px; overflow: hidden; box-shadow: 0 2px 10px rgba(40,35,25,0.18); background: rgba(255,253,248,0.94); }
			#zoom button { width: 40px; height: 40px; border: 0; background: transparent; color: #3b3630; font: 500 22px/1 ui-sans-serif, system-ui, sans-serif;
				cursor: pointer; touch-action: manipulation; }
			#zoom button + button { border-top: 1px solid rgba(60,50,40,0.12); }
			#zoom button:hover:not(:disabled) { background: rgba(0,0,0,0.05); }
			#zoom button:focus-visible { outline: 2px solid #b5643f; outline-offset: -2px; }
			#zoom button:disabled { color: rgba(59,54,48,0.3); cursor: default; }
			body.video .ui, body.hide-ui .ui { display: none; }
			#ambient-tint, #ambient-wash { position: fixed; inset: 0; z-index: 2; pointer-events: none; opacity: 0; transition: background-color 1.2s linear, opacity 0.6s; }
			#ambient-tint { mix-blend-mode: multiply; background: #fff; }
			#ambient-wash { mix-blend-mode: soft-light; }
			#ambient { position: fixed; left: 16px; bottom: calc(var(--credits-h, 32px) + 12px); z-index: 3; max-width: min(300px, calc(100vw - 100px)); padding: 8px 10px;
				border-radius: 12px; background: rgba(255,253,248,0.94); box-shadow: 0 2px 10px rgba(40,35,25,0.18); color: #3b3630;
				font: 13px/1.35 ui-sans-serif, system-ui, sans-serif; }
			#ambient .row { display: flex; align-items: center; gap: 8px; }
			#ambient .row { justify-content: space-between; }
			#ambient .now { color: #4d463e; }
			#ambient .actions { display: flex; gap: 6px; flex-shrink: 0; }
			#ambient button.done { background: #b5643f; color: #fff; }
			#ambient button { border: 0; background: rgba(0,0,0,0.06); color: inherit; border-radius: 8px; padding: 4px 8px; font: inherit; cursor: pointer; touch-action: manipulation; }
			#ambient button:hover { background: rgba(0,0,0,0.1); }
			#ambient button:focus-visible { outline: 2px solid #b5643f; outline-offset: 1px; }
			#lights { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; mix-blend-mode: screen; }
			#daytime { display: flex; gap: 4px; margin-top: 6px; }
			#ambient #daytime button { flex: 1; padding: 4px 2px; font-size: 12px; }
			#ambient #daytime button[aria-checked="true"] { background: #3b3630; color: #fff8ec; }
			#ambient-clock { font-variant-numeric: tabular-nums; font-weight: 600; color: #3b3630; }
			#help { margin-top: 6px; border-top: 1px solid rgba(60,50,40,0.12); padding-top: 6px; font-size: 12px; color: #4d463e; }
			#help p { margin: 0 0 6px; }
			#ambient #feedback-open { display: block; width: 100%; margin-top: 2px; padding: 6px 8px; color: #fff; background: #b5643f; font-weight: 600; }
			#ambient #feedback-open:hover { background: #9e5534; }
			#feedback { width: min(420px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); box-sizing: border-box; margin: auto; padding: 14px 16px; border: 0;
				border-radius: 12px; background: rgba(255,253,248,0.97); color: #3b3630; box-shadow: 0 8px 30px rgba(40,35,25,0.3);
				font: 13px/1.4 ui-sans-serif, system-ui, sans-serif; overflow: auto; }
			#feedback::backdrop { background: rgba(40,35,25,0.35); }
			#feedback .fb-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
			#feedback h2 { margin: 0; font-size: 15px; font-weight: 600; }
			#feedback button { border: 0; background: rgba(0,0,0,0.06); color: inherit; border-radius: 8px; padding: 6px 12px; font: inherit; cursor: pointer; touch-action: manipulation; }
			#feedback button:hover:not(:disabled) { background: rgba(0,0,0,0.1); }
			#feedback button:focus-visible, #feedback input:focus-visible, #feedback textarea:focus-visible { outline: 2px solid #b5643f; outline-offset: 1px; }
			#feedback .fb-close { padding: 2px 9px; font-size: 18px; line-height: 1.2; }
			#feedback .fb-kind { display: flex; gap: 16px; margin: 0 0 8px; padding: 0; border: 0; }
			#feedback .fb-kind legend { padding: 0; margin-bottom: 4px; color: #4d463e; }
			#feedback .fb-kind label { display: flex; align-items: center; gap: 5px; cursor: pointer; }
			#feedback input[type=radio] { accent-color: #b5643f; margin: 0; }
			#feedback .fb-field { display: block; margin-bottom: 8px; color: #4d463e; }
			#feedback textarea, #feedback input[type=text] { display: block; width: 100%; box-sizing: border-box; margin-top: 3px; padding: 7px 8px;
				border: 1px solid rgba(60,50,40,0.25); border-radius: 8px; background: #fff; color: #3b3630; font: 16px/1.35 ui-sans-serif, system-ui, sans-serif; }
			#feedback textarea { resize: vertical; min-height: 96px; }
			#feedback .fb-opt { color: #8a8178; }
			#feedback .fb-hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
			#feedback .fb-note { margin: 0 0 10px; font-size: 11.5px; color: #6b635a; }
			#feedback .fb-actions { display: flex; justify-content: flex-end; gap: 8px; }
			#feedback .fb-send { background: #b5643f; color: #fff; font-weight: 600; }
			#feedback .fb-send:hover:not(:disabled) { background: #9e5534; }
			#feedback .fb-send:disabled { opacity: 0.6; cursor: default; }
			#feedback .fb-status { margin: 8px 0 0; min-height: 1em; }
			#feedback .fb-status:empty { display: none; }
			#feedback .fb-status.ok { color: #3d6b35; }
			#feedback .fb-status.error { color: #a1381f; }
			#feedback .fb-status a { color: #b5643f; font-weight: 600; }
			#help .keys b { display: inline-block; min-width: 1.2em; text-align: center; border: 1px solid rgba(60,50,40,0.25); border-radius: 4px; padding: 0 3px; }
			#preview { position: fixed; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; background: #e8e4dc; }
			/* landscape: the image is 0.8 × as tall as wide; portrait and squarish screens: 2.2 × (export.ts PREVIEWS) */
			#preview .frame { position: absolute; left: 0; top: 50%; width: 100%; aspect-ratio: 1 / 0.8; transform: translateY(-50%); }
			#preview .lqip { position: absolute; inset: 0; background: var(--lqip-land) center / 100% 100%; filter: blur(12px); }
			#preview img { position: absolute; inset: 0; width: 100%; height: 100%; }
			@media (max-aspect-ratio: 5/4) {
				#preview .frame { aspect-ratio: 1 / 2.2; }
				#preview .lqip { background-image: var(--lqip-port); }
			}
			#overlay { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }
			#credits { position: fixed; right: 0; bottom: 0; z-index: 10; font-size: 11px; line-height: 1.4; max-width: calc(100vw - 48px);
				padding: 3px calc(8px + env(safe-area-inset-right, 0px)) calc(3px + env(safe-area-inset-bottom, 0px)) 8px;
				background: rgba(255, 255, 255, 0.85); color: #333; border-top-left-radius: 6px; }
			#credits .credit { white-space: nowrap; }
			#credits a { color: #0b63c5; text-decoration: none; touch-action: manipulation; }
			@media (pointer: coarse) { #credits { font-size: 12px; } #credits a { padding: 4px 0; } }
			/* phones: a full-width bar with left-aligned lines, clear of the notch corners and the home indicator */
			#credits-toggle { display: none; }
			@media (pointer: coarse) { #help .keys { display: none; } } /* keyboard shortcuts: not on touch screens */
			@media (max-width: 640px) {
				#credits .credit:not(:first-child) { display: none; }
				body.credits-open #credits .credit { display: inline; }
				#credits-toggle { display: inline-block; border: 0; background: rgba(0,0,0,0.07); color: #333; border-radius: 6px;
					padding: 4px 9px; margin-left: 4px; font: inherit; cursor: pointer; touch-action: manipulation; }
				#credits { left: 0; max-width: none; border-radius: 0; text-align: left;
					padding: 5px calc(12px + env(safe-area-inset-right, 0px)) calc(5px + env(safe-area-inset-bottom, 0px)) calc(12px + env(safe-area-inset-left, 0px)); }
			}
			#video-credit { display: none; position: fixed; z-index: 10; left: 50%; bottom: calc(9svh + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%);
				width: max-content; max-width: 92vw; padding: 0.35em 0.8em; border-radius: 0.5em; text-align: center;
				font-size: clamp(10px, 1.55vmin, 15px); font-weight: 500; line-height: 1.4; color: rgba(255, 255, 255, 0.95);
				background: rgba(10, 12, 16, 0.42); backdrop-filter: blur(4px); text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5); pointer-events: none; }
			body.video #video-credit { display: block; }
			body.video #credits { display: none; }
		</style>

		<script>
			import '../scripts/map.ts';
			import '../scripts/feedback.ts';
			import '../scripts/share.ts';
		</script>
	</body>
</html>
