{
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "installCommand": "npm install",
  "framework": null,
  "git": {
    "deploymentEnabled": true
  },
  "rewrites": [
    {
      "source": "/p/:route",
      "destination": "/api/p?route=:route"
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ]
}
